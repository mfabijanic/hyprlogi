[Unit]
Description=Hyprland Haptic Feedback Service
After=graphical-session.target hyprland-session.target openlogi-agent.service logid.service
PartOf=graphical-session.target

[Service]
# install.sh rewrites this path for `uv tool install` / `pipx install` (~/.local/bin)
ExecStart=/usr/bin/hyprlogi daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
